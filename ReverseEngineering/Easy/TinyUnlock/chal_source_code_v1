// TinyUnlock - very easy reverse-engineering challenge
// Build: gcc -O2 -s -o tinyunlock tinyunlock.c

#include <stdio.h>
#include <string.h>
#include <stdint.h>

static unsigned char encoded[] = { 74, 71, 78, 78, 81, 54, 52 };
static const int REQ_LEN = 7;

int check_key(const char *s) {
    if (!s) return 0;
    if ((int)strlen(s) != REQ_LEN) return 0;

    for (int i = 0; i < REQ_LEN; ++i) {
        unsigned char t = (unsigned char)s[i] + 2; // simple transform
        if (t != encoded[i]) return 0;
    }
    return 1;
}

int main(void) {
    char buf[32];
    printf("Enter unlock key: ");
    if (!fgets(buf, sizeof(buf), stdin)) return 0;
    char *nl = strchr(buf, '\n'); if (nl) *nl = '\0';

    if (check_key(buf)) {
        printf("Unlocked!\n");
        printf("FLAG{%s}\n", buf);
    } else {
        printf("Wrong key.\n");
    }
    return 0;
}
